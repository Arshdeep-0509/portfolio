# Used for canonical URLs, Open Graph and sitemap until siteConfig.url is set to the real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Newsletter sign-ups are POSTed here as JSON when set (e.g. an email provider or automation webhook).
# Without it, sign-ups are appended to .data/newsletter-subscribers.jsonl (local / single-server only).
NEWSLETTER_WEBHOOK_URL=

# Preview draft case studies and posts in a production build.
SHOW_DRAFTS=false

# ── Forms: careers (/careers) and contact (/contact) ─────────────────────────────────────────
# Every service below is optional in development: leave it blank and a local mock is used
# (files under .data/, which is git-ignored). Configure all of them before launch.

# Cloudflare Turnstile — bot check for the contact AND careers forms. Blank = widget hidden and
# verification skipped.
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private resume storage — any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage S3).
# Keep the bucket private. Blank = resumes saved to .data/careers/resumes/.
# R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (region "auto")
# S3 endpoint: https://s3.<REGION>.amazonaws.com · Supabase: https://<PROJECT>.supabase.co/storage/v1/s3
RESUME_S3_ENDPOINT=
RESUME_S3_BUCKET=
RESUME_S3_REGION=auto
RESUME_S3_ACCESS_KEY_ID=
RESUME_S3_SECRET_ACCESS_KEY=
# Lifetime of the signed resume link in the notification email (1–7 days).
RESUME_LINK_EXPIRY_DAYS=7

# Application database — Supabase table `career_applications` (SQL in src/lib/careers/applications.ts).
# Server-only key: never prefix with NEXT_PUBLIC_. Blank = .data/careers/applications.jsonl.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where new applications are sent. Blank = siteConfig.email.
CAREERS_INBOX_EMAIL=

# ── Contact form (/contact → POST /api/contact) ─────────────────────────────────────────────
# Where new leads are emailed (reply-to is set to the lead). Blank = siteConfig.email.
CONTACT_TO_EMAIL=

# Lead database: PostgreSQL via Prisma (any host — Supabase, Neon, RDS…).
# Apply the schema with `pnpm db:migrate`. Blank = leads appended to .data/leads.jsonl.
DATABASE_URL=

# Rate limiting shared by all forms (contact: 5/hour per IP). Blank = in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional instant pings for new leads.
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional error reporting (Sentry). Blank = errors are only logged to the server console.
# Browser errors and React error boundaries use the public DSN (it's safe to expose); the server
# uses SENTRY_DSN, falling back to the public one. Usually both hold the same DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ── Email (contact + careers) ───────────────────────────────────────────────────────────────
# First configured provider wins: Resend → SMTP (Nodemailer) → mock (writes each email to
# .data/outbox/*.html and logs a line to the console).
# Sender on a domain you've verified with your provider, e.g. "Arshdeep Singh <hello@[DOMAIN]>"
EMAIL_FROM=
RESEND_API_KEY=
# SMTP fallback, e.g. smtp.gmail.com / 465 with an app password, or Zoho / Brevo / SES SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Analytics (loaded ONLY after the visitor accepts analytics cookies) ────────────────────
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. Runs with Google Consent Mode v2.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project id.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Optional cookieless alternative to GA4 (no consent needed): your site's domain in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible? Point this at its script. Default: https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=

# ── Search & monitoring ─────────────────────────────────────────────────────────────────────
# Google Search Console → "HTML tag" verification: paste only the content="…" value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Release identifier shown by /api/health (set automatically by the Docker build).
APP_VERSION=
