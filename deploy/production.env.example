# Copy to deploy/production.env on the server (git-ignored) and fill in. Used by docker-compose.yml.
# NEXT_PUBLIC_* values are baked into the browser bundle when the image is BUILT (GitHub Actions
# reads them from repository variables); they're repeated here for local `docker compose build`.

# ── Site ─────────────────────────────────────────────────────────────────────────────────────
DOMAIN=example.com
NEXT_PUBLIC_SITE_URL=https://example.com
CERTBOT_EMAIL=you@example.com

# ── Database (the db service creates it on first start) ──────────────────────────────────────
POSTGRES_USER=site
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=site
DATABASE_URL=postgresql://site:change-me-to-a-long-random-string@db:5432/site

# ── Everything else the app reads (see .env.example for descriptions) ───────────────────────
CONTACT_TO_EMAIL=
CAREERS_INBOX_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESUME_S3_ENDPOINT=
RESUME_S3_BUCKET=
RESUME_S3_REGION=auto
RESUME_S3_ACCESS_KEY_ID=
RESUME_S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
SLACK_WEBHOOK_URL=

# ── Nightly backups (backup service) ─────────────────────────────────────────────────────────
BACKUP_S3_BUCKET=
# e.g. https://<account>.r2.cloudflarestorage.com — leave empty for AWS S3
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
